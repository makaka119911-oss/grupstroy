---
import LogoMarkAtelier from './logo/LogoMarkAtelier.astro';
import LogoMarkChisel from './logo/LogoMarkChisel.astro';
import LogoMarkGrain from './logo/LogoMarkGrain.astro';
import LogoMarkJoinery from './logo/LogoMarkJoinery.astro';
import LogoMarkMitre from './logo/LogoMarkMitre.astro';
import LogoMarkMonolith from './logo/LogoMarkMonolith.astro';

export type LogoVariant = 'atelier' | 'joinery' | 'monolith' | 'grain' | 'mitre' | 'chisel';

interface Props {
  compact?: boolean;
  variant?: LogoVariant;
}

const { compact = false, variant = 'joinery' } = Astro.props;

const marks = {
  atelier: LogoMarkAtelier,
  joinery: LogoMarkJoinery,
  monolith: LogoMarkMonolith,
  grain: LogoMarkGrain,
  mitre: LogoMarkMitre,
  chisel: LogoMarkChisel,
} as const;

const Mark = marks[variant];
---

<a class:list={['logo', compact && 'logo--compact']} href="/">
  <Mark />
  <span class="logo__text">
    <span class="logo__name">GRUPSTROY</span>
    {!compact && <span class="logo__sub">столярная мануфактура</span>}
  </span>
</a>
