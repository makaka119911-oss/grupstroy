---
import LogoMarkChampagne from './logo/LogoMarkChampagne.astro';
import LogoMarkCognac from './logo/LogoMarkCognac.astro';
import LogoMarkMalt from './logo/LogoMarkMalt.astro';
import LogoMarkSeal from './logo/LogoMarkSeal.astro';
import LogoMarkVodka from './logo/LogoMarkVodka.astro';
import LogoMarkWhisky from './logo/LogoMarkWhisky.astro';

export type LogoVariant = 'cognac' | 'whisky' | 'malt' | 'vodka' | 'champagne' | 'seal';

interface Props {
  compact?: boolean;
  variant?: LogoVariant;
}

const { compact = false, variant = 'seal' } = Astro.props;

const marks = {
  cognac: LogoMarkCognac,
  whisky: LogoMarkWhisky,
  malt: LogoMarkMalt,
  vodka: LogoMarkVodka,
  champagne: LogoMarkChampagne,
  seal: LogoMarkSeal,
} as const;

const Mark = marks[variant];
---

<a class:list={['logo', compact && 'logo--compact']} href="/">
  <Mark />
  <span class="logo__text">
    <span class="logo__name">GRUPSTROY</span>
    {!compact && <span class="logo__sub">столярная мануфактура</span>}
  </span>
</a>
