>
  <defs>
    <linearGradient id="gsGold" x1="8" y1="6" x2="40" y2="42" gradientUnits="userSpaceOnUse">
      <stop stop-color="#E8D4A8"></stop>
      <stop offset="0.5" stop-color="#C9A86C"></stop>
