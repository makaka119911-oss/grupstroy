---
/** Монограмма: шип-паз + торец доски — столярная точность */
---
<svg
  class="logo__mark"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 56 56"
  width="44"
  height="44"
  fill="none"
  aria-hidden="true"
>
  <defs>
    <linearGradient id="lgGold" x1="6" y1="4" x2="50" y2="52" gradientUnits="userSpaceOnUse">
      <stop stop-color="#F2E4C6"></stop>
      <stop offset="0.45" stop-color="#D4AF6A"></stop>
      <stop offset="1" stop-color="#9A7B3C"></stop>
    </linearGradient>
    <linearGradient id="lgWood" x1="8" y1="48" x2="48" y2="8" gradientUnits="userSpaceOnUse">
      <stop stop-color="#4A3C32"></stop>
      <stop offset="1" stop-color="#1E1814"></stop>
    </linearGradient>
    <linearGradient id="lgGrain" x1="0" y1="28" x2="56" y2="28" gradientUnits="userSpaceOnUse">
      <stop stop-color="#fff" stop-opacity="0.06"></stop>
      <stop offset="0.5" stop-color="#fff" stop-opacity="0"></stop>
