  </g>
  <rect x="4" y="4" width="48" height="48" rx="14" stroke="url(#lgGold)" stroke-width="1.25"></rect>
  <!-- Dovetail G -->
  <path
    d="M17 17h14c4.5 0 8 3.5 8 8s-3.5 8-8 8H25v-6h6c1.1 0 2-.9 2-2s-.9-2-2-2h-6v-6h8c2.2 0 4 1.8 4 4v2c0 3.3-2.7 6-6 6H17V17z"
    fill="url(#lgGold)"></path>
  <path
    d="M32 17 L40 25 L36 29 L28 21 Z"
    fill="#F2E4C6"
    opacity="0.85"></path>
  <path
    d="M15 39 L23 31 L27 35 L19 43 Z"
    fill="#C9A86C"
