    </div>
    <div>
      <p class="footer__label">Каталог</p>
      <a href="/kuhnya">Кухня</a>
      <a href="/korpus">Корпусная</a>
      <a href="/dekor">Интерьер</a>
      <a href="/malaya-forma">Малая форма</a>
