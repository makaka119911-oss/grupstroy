---
import Logo from './Logo.astro';

interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;

const nav = [
  { href: home ? '#panel-hero' : '/', label: 'Главная' },
  { href: home ? '#panel-blocks' : '/#panel-blocks', label: 'Каталог' },
  { href: '/uslugi', label: 'Услуги' },
  { href: '/zayavka', label: 'Заявка' },
];

const dots = home
  ? [
      { id: 'panel-hero', label: 'Главная' },
      { id: 'panel-blocks', label: 'Каталог' },
      ...['kuhnya', 'korpus', 'dekor', 'malaya-forma', 'sad'].map((s, i) => ({
        id: `panel-${s}`,
        label: `Блок ${i + 1}`,
      })),
      { id: 'panel-services', label: 'Услуги' },
      { id: 'panel-cta', label: 'Заявка' },
    ]
  : [];
---

<header class:list={['header', 'header--seal', home && 'header--home']} id="header">
  <div class="container header__inner">
    <Logo />
    <nav class="nav" aria-label="Меню">
      {nav.map((item) => (
        <a href={item.href} data-nav-link>{item.label}</a>
      ))}
    </nav>
    <div class="header__actions">
      <a class="btn btn--primary btn--sm header__cta" href="/zayavka">Рассчитать</a>
      <button
        class="burger"
        type="button"
        aria-label="Открыть меню"
        aria-expanded="false"
        aria-controls="mobileNav"
        id="burger"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <div class="mobile-nav__backdrop" id="mobileBackdrop" hidden></div>
  <nav class="mobile-nav" id="mobileNav" aria-label="Мобильное меню" hidden>
    {nav.map((item) => (
      <a href={item.href} data-nav-link>{item.label}</a>
    ))}
    <a class="btn btn--primary btn--wide" href="/zayavka" data-nav-link>Рассчитать проект</a>
  </nav>
</header>

{
  home && (
    <nav class="snap-dots" aria-label="Разделы" id="snapDots">
      {dots.map((d, i) => (
        <button
          type="button"
          class="snap-dots__btn"
          data-target={d.id}
          aria-label={d.label}
          aria-current={i === 0 ? 'true' : undefined}
        >
          <span class="snap-dots__tip">{d.label}</span>
        </button>
      ))}
    </nav>
  )
}

<script>
  const header = document.getElementById('header');
  const burger = document.getElementById('burger');
  const mobileNav = document.getElementById('mobileNav');
  const backdrop = document.getElementById('mobileBackdrop');
  const getScroller = () => document.getElementById('homeScroll');

  function scrollToPanel(id: string) {
    const scroller = getScroller();
    const el = document.getElementById(id);
    if (!el) return;
    if (scroller) {
      const top = el.offsetTop - (header?.offsetHeight ?? 0);
      scroller.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
    } else {
      el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  function openMenu() {
    header?.classList.add('header--menu-open');
    mobileNav?.removeAttribute('hidden');
    backdrop?.removeAttribute('hidden');
    burger?.setAttribute('aria-expanded', 'true');
    burger?.setAttribute('aria-label', 'Закрыть меню');
    document.body.classList.add('menu-open');
  }

  function closeMenu() {
    header?.classList.remove('header--menu-open');
    mobileNav?.setAttribute('hidden', '');
    backdrop?.setAttribute('hidden', '');
    burger?.setAttribute('aria-expanded', 'false');
    burger?.setAttribute('aria-label', 'Открыть меню');
    document.body.classList.remove('menu-open');
  }

  function isMenuOpen() {
    return header?.classList.contains('header--menu-open') ?? false;
  }

  burger?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (isMenuOpen()) closeMenu();
    else openMenu();
  });

  backdrop?.addEventListener('click', closeMenu);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isMenuOpen()) closeMenu();
  });

  document.querySelectorAll('[data-nav-link]').forEach((link) => {
    link.addEventListener('click', (e) => {
      const anchor = link as HTMLAnchorElement;
      const href = anchor.getAttribute('href') ?? '';

      if (href.startsWith('#')) {
        e.preventDefault();
        scrollToPanel(href.slice(1));
        history.replaceState(null, '', href);
      }

      closeMenu();
    });
  });

  window.addEventListener('resize', () => {
    if (window.matchMedia('(min-width: 768px)').matches && isMenuOpen()) {
      closeMenu();
    }
  });

  const homeScroller = getScroller();
  if (homeScroller && header?.classList.contains('header--home')) {
    homeScroller.addEventListener(
      'scroll',
      () => {
        header.classList.toggle('header--scrolled', homeScroller.scrollTop > 48);
      },
      { passive: true }
    );
  }

  const dots = document.getElementById('snapDots');
  const panels = document.querySelectorAll('.snap-panel');
  if (dots && panels.length && homeScroller) {
    const btns = dots.querySelectorAll('.snap-dots__btn');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting && e.intersectionRatio > 0.45) {
            const id = e.target.id;
            btns.forEach((b) => {
              b.setAttribute('aria-current', b.getAttribute('data-target') === id ? 'true' : 'false');
            });
          }
        });
      },
      { root: homeScroller, threshold: [0.45, 0.6] }
    );
    panels.forEach((p) => observer.observe(p));

    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-target');
        if (id) scrollToPanel(id);
      });
    });
  }
</script>
