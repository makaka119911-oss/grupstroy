---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
import LogoMarkChampagne from '../components/logo/LogoMarkChampagne.astro';
import LogoMarkCognac from '../components/logo/LogoMarkCognac.astro';
import LogoMarkMalt from '../components/logo/LogoMarkMalt.astro';
import LogoMarkSeal from '../components/logo/LogoMarkSeal.astro';
import LogoMarkVodka from '../components/logo/LogoMarkVodka.astro';
import LogoMarkWhisky from '../components/logo/LogoMarkWhisky.astro';
import '../styles/logotip.css';

const options = [
  {
    id: 'cognac',
    tag: 'Вариант A',
    title: 'Cognac',
    desc: 'Овальная монограмма и золото — спокойная роскошь в духе Hennessy. Серьёзно, без лишней декоративности.',
    traits: ['Hennessy', 'Премиум', 'Классика'],
    Mark: LogoMarkCognac,
  },
  {
    id: 'whisky',
    tag: 'Вариант B',
    title: 'Whisky',
    desc: 'Диагональная полоса и строгий квадрат — динамика Johnnie Walker, но сдержанно и по-взрослому.',
    traits: ['Johnnie Walker', 'Сила', 'Графика'],
    Mark: LogoMarkWhisky,
  },
  {
    id: 'malt',
    tag: 'Вариант C',
    title: 'Malt',
    desc: 'Геральдический щит — наследие и ремесло, как у The Macallan: статус без крика.',
    traits: ['Macallan', 'Герб', 'Массив'],
    Mark: LogoMarkMalt,
  },
  {
    id: 'vodka',
    tag: 'Вариант D',
    title: 'Vodka',
    desc: 'Тонкие кольца и воздух — минимализм Beluga: чистая форма, дорогая простота.',
    traits: ['Beluga', 'Минимализм', 'Точность'],
    Mark: LogoMarkVodka,
  },
  {
    id: 'champagne',
    tag: 'Вариант E',
    title: 'Champagne',
    desc: 'Звезда и гербовый щит — праздничная строгость Moët: свет, но не театр.',
    traits: ['Moët', 'Статус', 'Свет'],
    Mark: LogoMarkChampagne,
  },
  {
    id: 'seal',
    tag: 'Вариант F',
    title: 'Seal',
    desc: 'Восковая печать с монограммой — доверие и ручная работа, отсылка к Rémy Martin.',
    traits: ['Rémy Martin', 'Печать', 'Доверие'],
    Mark: LogoMarkSeal,
  },
] as const;
---

<Layout title="Выбор логотипа — GRUPSTROY" description="Шесть премиальных вариантов логотипа GRUPSTROY">
  <div class="logotip-page">
    <div class="container">
      <a class="logotip-back" href="/">← На главную</a>
      <header class="logotip-hero">
        <h1>Выбери логотип</h1>
        <p>Шесть строгих концептов в духе премиальных брендов. Нажми «Выбрать» — напиши в чат букву A–F.</p>
      </header>

      <div class="logotip-grid">
        {
          options.map((opt) => (
            <article class="logotip-card" data-variant={opt.id}>
              <div class="logotip-card__bar">
                <Logo variant={opt.id} compact />
              </div>
              <div class="logotip-card__stage">
                <opt.Mark />
              </div>
              <div class="logotip-card__body">
                <p class="logotip-card__tag">{opt.tag}</p>
                <h2 class="logotip-card__title">{opt.title}</h2>
                <p class="logotip-card__desc">{opt.desc}</p>
                <div class="logotip-card__traits">
                  {opt.traits.map((t) => <span>{t}</span>)}
                </div>
                <button type="button" class="btn btn--primary logotip-pick" data-pick={opt.id}>
                  Выбрать {opt.tag.split(' ')[1]}
                </button>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
  <div class="logotip-toast" id="logotipToast" role="status"></div>
</Layout>

<script>
  const STORAGE_KEY = 'grupstroy-logo-variant';
  const labels: Record<string, string> = {
    cognac: 'A — Cognac',
    whisky: 'B — Whisky',
    malt: 'C — Malt',
    vodka: 'D — Vodka',
    champagne: 'E — Champagne',
    seal: 'F — Seal',
  };

  const toast = document.getElementById('logotipToast');
  const saved = localStorage.getItem(STORAGE_KEY);
  if (saved) {
    document.querySelector(`[data-variant="${saved}"]`)?.classList.add('is-picked');
  }

  document.querySelectorAll('[data-pick]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-pick');
      if (!id) return;
      localStorage.setItem(STORAGE_KEY, id);
      document.querySelectorAll('.logotip-card').forEach((c) => c.classList.remove('is-picked'));
      document.querySelector(`[data-variant="${id}"]`)?.classList.add('is-picked');
      if (toast) {
        toast.textContent = `Выбран ${labels[id] ?? id}. Напиши в чат — поставлю на весь сайт.`;
        toast.classList.add('is-show');
        setTimeout(() => toast.classList.remove('is-show'), 4000);
      }
    });
  });
</script>
